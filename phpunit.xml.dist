<?xml version="1.0" encoding="UTF-8"?>
<!--
    The plugin's tests, booted inside WordPress with WooCommerce by
    WordPress's own PHPUnit test library (tests/bootstrap.php), in the
    WordPress container: scripts/test wordpress. Outbound HTTP to Monokulo
    is answered by `pre_http_request`, and webhooks are checked against
    Monokulo's published vectors (tests/vectors).

    The smoke test against a real Monokulo has its own config,
    phpunit.smoke.xml (scripts/smoke).
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    failOnWarning="true"
    failOnRisky="true"
    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
>
    <testsuites>
        <testsuite name="wordpress">
            <!--
                suffix="Test.php": PHPUnit wants a file's class named as the
                file is (GatewayRegistrationTest.php declares
                GatewayRegistrationTest).
            -->
            <directory suffix="Test.php">./tests/</directory>
            <exclude>./tests/Smoke</exclude>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <file>monokulo.php</file>
            <directory suffix=".php">includes</directory>
        </include>
    </coverage>
</phpunit>
