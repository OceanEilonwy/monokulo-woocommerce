#!/bin/sh
# Runs the smoke suite against a fresh Monokulo on this machine's network,
# twice, then stops it:
#
#   web    Monokulo at http://localhost:18092 with no onion address
#          (docker/monokulo-smoke.toml).
#   onion  Monokulo under a path, http://localhost:18092/monokulo, behind a
#          proxy that strips the path (nginx, docker/smoke-proxy.conf), with
#          an onion address served by an external tor
#          (docker/monokulo-smoke-onion.toml; no tor runs, Monokulo only
#          needs to know its address).
#
# Before each, the shop forgets any connection. The shop must be up and
# the plugin installed (scripts/test up && scripts/test install).
#
# Which Monokulo:
#   MONOKULO_BIN=/path/to/monokulo   a binary built from the pinned commit, or
#   MONOKULO_IMAGE=ghcr.io/...       its Docker image (the default:
#                                    monokulo:smoke, built by CI from the
#                                    commit in tests/vectors/PIN)
# SMOKE_ONLY=web|onion runs one of the two.
set -eu
cd "$(dirname "$0")/.."

onion=http://2gzyxa5ihm7nsggfxnu52rck2vv4rvmdlkiu3zzui5du4xyclen53wid.onion
data=
pid=

stop() {
	if [ -n "$pid" ]; then
		kill "$pid" 2>/dev/null || true
		wait "$pid" 2>/dev/null || true
		pid=
	elif [ -n "$data" ]; then
		docker logs monokulo-woocommerce-smoke >> "$data/monokulo.log" 2>&1 || true
		docker stop monokulo-woocommerce-smoke > /dev/null 2>&1 || true
	fi
	docker stop monokulo-woocommerce-smoke-proxy > /dev/null 2>&1 || true
}

cleanup() {
	status=$?
	stop
	if [ "$status" != 0 ] && [ -n "$data" ]; then
		echo "--- Monokulo's log ---"
		tail -n 100 "$data/monokulo.log" 2>/dev/null || true
	fi
	[ -z "$data" ] || rm -rf "$data"
	exit "$status"
}
trap cleanup EXIT INT TERM

# smoke <options file> <url> <onion address or ''> [phpunit args]
smoke() {
	options=$1 url=$2 onion_uri=$3
	shift 3
	data=$(mktemp -d)
	key=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
	if [ -n "${MONOKULO_BIN:-}" ]; then
		MONOKULO_ENCRYPTION_KEY=$key "$MONOKULO_BIN" --options "$options" \
			--database-path "$data/monokulo.db" --logging-format json > "$data/monokulo.log" 2>&1 &
		pid=$!
	else
		chmod 777 "$data"
		docker run -d --rm --name monokulo-woocommerce-smoke --network host \
			-e MONOKULO_ENCRYPTION_KEY="$key" \
			-v "$PWD/$options:/etc/monokulo.toml:ro" -v "$data:/data" \
			"${MONOKULO_IMAGE:-monokulo:smoke}" monokulo --options /etc/monokulo.toml \
			--database-path /data/monokulo.db --logging-format json > /dev/null
	fi

	for i in $(seq 1 60); do
		if curl -fs -o /dev/null "$url/status" || curl -s -o /dev/null -w '%{http_code}' "$url/" | grep -q 302; then
			break
		fi
		sleep 1
	done

	# A shop that hasn't been connected: no settings, no kept entry.
	docker compose -f docker/compose.yaml exec -T wordpress sh -c \
		'wp --allow-root --path=/var/www/html option delete woocommerce_monokulo_settings monokulo_api_entry' > /dev/null 2>&1 || true

	MONOKULO_URL=$url MONOKULO_ONION=$onion_uri scripts/test smoke "$@"
	stop
	rm -rf "$data"
	data=
}

case "${SMOKE_ONLY:-}" in
'' | web)
	smoke docker/monokulo-smoke.toml http://localhost:18092 '' "$@"
	;;
esac

case "${SMOKE_ONLY:-}" in
'' | onion)
	docker pull -q nginx:1.27-alpine > /dev/null
	docker run -d --rm --name monokulo-woocommerce-smoke-proxy --network host \
		-v "$PWD/docker/smoke-proxy.conf:/etc/nginx/conf.d/default.conf:ro" nginx:1.27-alpine > /dev/null
	smoke docker/monokulo-smoke-onion.toml http://localhost:18092/monokulo "$onion" "$@"
	;;
esac
